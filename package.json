{
  "name": "where-is-ip",
  "version": "0.2.2",
  "description": "Look up IP locations with native fetch and automatic fallback between keyless providers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omyto/where-is-ip.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "jsdelivr": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.global.js",
    "dist/index.d.ts",
    "dist/index.d.cts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "keywords": ["ip-geolocation", "geoip", "ip-lookup", "ip-location", "ipv4", "ipv6"],
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
